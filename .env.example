# ============================================================
# smart-study-room Docker 编排环境变量模板
# 复制为 .env 后按需修改（.env 已被 .gitignore 忽略，不会入库）：
#   cp .env.example .env        # Linux/macOS/Git Bash
#   copy .env.example .env      # Windows CMD
#
# 不提供 .env 时，docker compose 会自动使用下述默认值，可直接启动。
# ============================================================

# PostgreSQL 容器内超级用户 / 密码 / 数据库名
POSTGRES_USER=studyroom
POSTGRES_PASSWORD=studyroom
POSTGRES_DB=studyroom

# 后端映射到宿主机的端口（默认 8080，与前端 Vite 代理一致；
# 若本机 8080 被其它服务占用，可改为如 8081，并同步调整
# frontend/vite.config.js 的代理目标端口）
STUDYROOM_HOST_PORT=8080

# 后端 JWT 签名密钥（生产环境务必替换为强随机值）
STUDYROOM_JWT_SECRET=studyroom-dev-secret
