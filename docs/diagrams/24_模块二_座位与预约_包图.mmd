%% 图 3-11 模块二：座位与预约模块 包图
flowchart LR
    subgraph M2["模块二：座位与预约模块"]
        subgraph UI["界面交互层"]
            direction LR
            U1["座位平面图<br/>与在线选座"]
            U2["我的预约看板"]
            U3["智能自动分配<br/>偏好对话框"]
            U4["房间与座位管理<br/>（管理端）"]
        end
        subgraph SVC["业务逻辑层"]
            direction LR
            S1["房间座位服务<br/>SeatService"]
            S2["预约服务<br/>ReservationService"]
            S3["生命周期服务<br/>LifecycleService"]
            S4["智能分配服务<br/>AllocationService"]
        end
        subgraph DAO["数据访问层"]
            direction LR
            R1["房间/座位/预约<br/>数据访问"]
        end
        subgraph SUP["支撑组件"]
            direction LR
            C1["分布式互斥锁"]
            C2["座位图缓存"]
        end
    end

    CREDIT["模块三：信用服务<br/>（取消临近扣分）"]
    NOTIFY["通知服务<br/>（预约结果推送）"]
    SCHED["模块五：后台调度器<br/>（超时违约巡检）"]
    DB[("数据库<br/>房间/座位/预约表<br/>＋时段排除约束")]

    U1 --> S2
    U2 --> S3
    U3 --> S4
    U4 --> S1
    S2 --> R1
    S3 --> R1
    S4 --> S1
    S1 --> R1
    R1 --> DB
    S2 --> C1
    S2 --> CREDIT
    S2 --> NOTIFY
    S4 --> S2
    S3 --> NOTIFY
    SCHED --> S3
    S1 --> C2

    classDef ext fill:#f5f5f5,stroke:#999,stroke-dasharray: 4 3
    class CREDIT,NOTIFY,SCHED,DB ext
